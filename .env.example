# Local application configuration. Copy to .env and supply your own secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false

# MongoDB uses the database named "number0" (see src/config/db.js).
MONGO_URI=mongodb://127.0.0.1:27017
# Change streams require a replica set or Atlas. Disable for standalone MongoDB.
ENABLE_DEPOSIT_WATCHER=false
# true starts only the HTTP layer; /ready returns 503 without MongoDB.
SKIP_DB_CONNECT=false

# Generate independent secrets with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_JWT_SECRET=
ADMIN_TOKEN_EXPIRY=8h
ADMIN_SESSION_COOKIE_NAME=sessionToken

# Optional OAuth providers. Empty credentials leave the provider disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT=http://localhost:3001/api/auth/discord/callback
OAUTH_SUCCESS_PATH=/dashboard
# Required for production login and registration.
RECAPTCHA_SECRET_KEY=

# Wallet setup. Use disposable development wallets for this prototype.
# BITCOIN_NETWORK affects Bitcoin only; Litecoin is configured for mainnet.
BITCOIN_NETWORK=testnet
BTC_MNEMONIC=
LTC_MNEMONIC=

# Optional transaction-building utilities (not wired to HTTP payout routes).
GETBLOCK_BTC_URL=
GETBLOCK_LTC_URL=
XPRIV_ENCRYPTION_KEY=
XPRIV_ENCRYPTION_SALT=

# For start:cluster, export WEB_CONCURRENCY in the shell (the supervisor does
# not read .env). Use one worker for Socket.IO and per-process rate limits.
WEB_CONCURRENCY=1
RATE_LIMIT_ENABLED=true
REQUEST_LOGGING=true
REQUEST_LOG_SAMPLE_RATE=1
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
LOG_SOCKET_EVENTS=true
HTTP_ETAG=false
JSON_BODY_LIMIT=10kb

# HTTP server tuning (milliseconds, except backlog).
KEEP_ALIVE_TIMEOUT_MS=72000
HEADERS_TIMEOUT_MS=73000
REQUEST_TIMEOUT_MS=300000
LISTEN_BACKLOG=4096

# Optional MongoDB connection-pool tuning.
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
